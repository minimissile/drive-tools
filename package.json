{
  "name": "panxu-studio",
  "version": "0.0.5",
  "private": true,
  "description": "盘序 · 本地网盘内容营销工作台",
  "type": "module",
  "main": "dist-desktop/main.js",
  "author": "Panxu Studio",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:window": "node scripts/dev-window.mjs",
    "test:session": "node --import tsx scripts/run-dev-test-session.mjs",
    "build:icons": "node scripts/generate-icons.mjs",
    "build": "tsc --noEmit && vite build && npm run build:video && node scripts/build-desktop.mjs",
    "build:video": "node scripts/build-video.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:video": "node --import tsx --test tests/video-renderer.test.ts tests/video-service.test.ts tests/video-ipc.test.ts tests/resource-video-source.test.ts tests/studio.test.ts",
    "test:video:render": "npm run build:video && node --import tsx scripts/check-local-video-render.ts",
    "test:video:frames": "node --import tsx scripts/check-video-directory-frames.ts",
    "test:music": "node --import tsx --test tests/music-service.test.ts tests/music-backup.test.ts tests/music-ipc.test.ts",
    "test:bilibili": "node --import tsx --test tests/bilibili-accounts.test.ts tests/bilibili-content.test.ts tests/bilibili-editor-page.test.ts",
    "test:e2e:bilibili": "npm run test:session -- --module scripts/qa-bilibili-ui.mjs --label 哔哩哔哩内容界面 --close",
    "test:e2e:hot-music": "npm run test:session -- --module scripts/qa-hot-music-ui.mjs --label 热门配乐界面 --close",
    "test:e2e:local-video": "npm run test:session -- --module scripts/qa-local-video-ui.mjs --label 本地视频制作界面 --close",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:csdn": "node --import tsx scripts/e2e-csdn.mjs",
    "test:e2e:drives": "node scripts/e2e-drives.mjs",
    "test:e2e:packaged": "node scripts/e2e-packaged.mjs",
    "test:e2e:production": "node scripts/e2e-production.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "package:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg zip --arm64 --publish never",
    "package:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "package:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "verify:providers": "node --import tsx --test tests/providers.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"{desktop,core,shared,tests}/**/*.ts\" \"scripts/*.mjs\"",
    "verify:updates": "node scripts/verify-updates.mjs",
    "test:e2e:updates": "node scripts/e2e-updates.mjs",
    "test:e2e:search": "node scripts/e2e-search.mjs",
    "test:e2e:share-statistics": "node scripts/e2e-share-statistics.mjs",
    "test:e2e:ideas": "node scripts/e2e-ideas.mjs",
    "test:e2e:resource-export": "node scripts/e2e-resource-export.mjs",
    "test:e2e:studio-media": "node scripts/e2e-studio-media.mjs",
    "test:e2e:ui": "node scripts/e2e-ui.mjs",
    "test:e2e:ui-audit": "node scripts/e2e-ui-audit.mjs",
    "test:e2e:visual": "node scripts/e2e-visual.mjs",
    "test:e2e:controls": "node scripts/e2e-controls.mjs",
    "test:e2e:states": "node scripts/e2e-data-states.mjs",
    "test:e2e:toasts": "node scripts/e2e-toasts.mjs",
    "test:e2e:accounts": "node scripts/e2e-accounts.mjs",
    "test:e2e:environments": "node --import tsx scripts/e2e-browser-environments.mjs",
    "test:e2e:batch": "node scripts/e2e-batch.mjs",
    "test:e2e:intake": "node scripts/e2e-intake.mjs",
    "test:e2e:zhidao": "node scripts/e2e-zhidao.mjs",
    "test:e2e:zhidao-answers": "node --import tsx scripts/e2e-zhidao-answers.mjs",
    "test:e2e:zhidao-publishing": "node --import tsx scripts/e2e-zhidao-publishing.mjs",
    "build:pansou": "node scripts/build-pansou.mjs",
    "release:mac": "node scripts/package-release.mjs --platform mac",
    "release:win": "node scripts/package-release.mjs --platform win",
    "release:full": "node scripts/release-update.mjs --mode full",
    "release:differential": "node scripts/release-update.mjs --mode differential",
    "release:draft": "node scripts/release-update.mjs --resume --draft-only",
    "verify:updates:all": "node scripts/verify-updates.mjs --all",
    "test:updates:differential": "node scripts/verify-differential-update.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:setup:mac": "node scripts/configure-notary.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@remotion/bundler": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.9",
    "lucide-react": "1.57.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "semver": "7.7.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "prettier": "3.9.10",
    "proper-lockfile": "4.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.panxu.studio",
    "productName": "盘序",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**",
      "dist-desktop/**",
      "package.json",
      "!dist/**/*.map",
      "!dist-desktop/**/*.map"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/video-remotion",
        "to": "video-remotion"
      },
      {
        "from": "build/icon.png",
        "to": "brand/icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "盘序安装"
    },
    "asarUnpack": [
      "node_modules/@remotion/compositor*/**",
      "node_modules/@remotion/renderer/**",
      "node_modules/playwright-core/**"
    ],
    "artifactName": "Panxu-Studio-${version}-${os}-${arch}.${ext}",
    "toolsets": {
      "nsis": "1.2.1"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
