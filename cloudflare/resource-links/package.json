{
  "name": "panxu-resource-links",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "盘序独立资源领取页与固定入口服务",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "typescript": ">=5.9 <8",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22"
  }
}
