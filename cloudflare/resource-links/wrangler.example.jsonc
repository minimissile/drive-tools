{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "panxu-resource-links",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["ADMIN_TOKEN"] },
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "panxu-resource-links",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  // ADMIN_TOKEN is a Wrangler secret, never a vars entry or source-code value.
}
